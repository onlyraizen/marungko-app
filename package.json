{
  "name": "marungko-app",
  "version": "0.0.0",
  "private": true,
  "description": "Marungko Tagalog literacy app: Expo frontend, Express backend, shared schemas, Supabase.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:shared": "pnpm --filter ./packages/shared dev",
    "dev:backend": "pnpm --filter ./backend dev",
    "dev:frontend": "pnpm build:shared && pnpm --filter ./frontend start",
    "build": "pnpm -r --if-present build",
    "build:shared": "pnpm --filter ./packages/shared build",
    "build:backend": "pnpm build:shared && pnpm --filter ./backend build",
    "typecheck": "pnpm build:shared && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "content:validate": "tsx scripts/validate-content.mts",
    "content:seed": "tsx --env-file=backend/.env scripts/seed-curriculum.ts",
    "content:bundle-audio": "tsx scripts/bundle-offline-audio.ts",
    "clean": "rimraf backend/dist packages/shared/dist frontend/.expo",
    "content:count": "tsx scripts/count-characters.mts",
    "content:build": "tsx scripts/build-content.mts",
    "content:audio": "tsx --env-file=backend/.env scripts/generate-audio.mts",
    "voice:trial": "tsx --env-file=backend/.env scripts/voice-trial.mts",
    "content:compile-audio": "tsx scripts/compile-audio.mts",
    "content:normalize-audio": "tsx scripts/normalize-audio.mts",
    "content:import-voice": "tsx scripts/import-voice.mts",
    "voice:test": "tsx --env-file=backend/.env scripts/voice-test.mts"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
