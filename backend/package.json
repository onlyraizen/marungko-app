{
  "name": "@marungko/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express 5 orchestration API: Supabase JWT auth, Soniox temporary keys, ElevenLabs audio cache.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@marungko/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
