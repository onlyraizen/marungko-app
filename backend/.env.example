# --- Runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated browser origins (web dev only). Blank = none allowed.
CORS_ORIGINS=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only for custom auth domains
SUPABASE_JWT_ISSUER=
# Optional: only for legacy HS256 projects
SUPABASE_JWT_SECRET=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Soniox ---
# Create this key with ONLY these permissions: "Temporary API keys" + "Speech-to-text, real-time"
SONIOX_API_KEY=
SONIOX_TEMP_KEY_TTL_SECONDS=60
SONIOX_MAX_SESSION_SECONDS=60

# Soniox async (file) model; list with GET https://api.soniox.com/v1/models
SONIOX_ASYNC_MODEL=stt-async-v5
